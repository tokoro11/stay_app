<!DOCTYPE html>
<html>
  <head>
    <title>Stay2</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <header id="header">
  <div class="wrapper">
    <p class="logo"><a href="/">SAMPLE</a></p>
    <nav>
      <ul>
        
        <% if user_signed_in? %>
  <li class="user-menu">
    <div class="user-name" onclick="this.nextElementSibling.classList.toggle('hidden')">
      <%= image_tag current_user.image, class: "card-img-top2" if current_user.image.attached? %>
      <%= current_user.name %> <span>▼</span>
    </div>
    <ul class="dropdown hidden">
      <li><%= link_to 'ルーム登録', new_room_path %></li>
      <li><%= link_to '予約済みルーム一覧', reservations_path %></li>
      <li><%= link_to '登録済みルーム一覧', rooms_path %></li>
      <li><%= link_to '設定', users_profile_path %></li>
      <li><%= button_to 'サインアウト', destroy_user_session_path, method: :delete %></li>
    </ul>
  </li>
<% else %>
  <li><%= link_to 'サインイン', new_user_session_path %></li>
  <li><%= link_to 'サインアップ', new_user_registration_path %></li>
<% end %>
      </ul>
    </nav>
  </div>
  
</header>

  <body>
  
    <%= yield %>
  </body>
</html>

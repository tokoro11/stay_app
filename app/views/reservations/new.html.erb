<div class="text-center">
  <div class="card room-card">
    <%= image_tag @room.image, class: "card-img-top" if @room.image.attached? %>

    <div class="card-body">
      <div class="room-name">
        <h3><%= @room.title %></h3>
        <p><%= @room.live %></p>
        <p><%= @room.content %></p>
      </div>

      <hr>
      <p>¥<%= @room.money %> / 泊</p>
    </div>
  </div>
</div>

<h1>予約フォーム</h1>

<!-- フラッシュメッセージ -->
<% if flash[:notice] %>
  <p style="color: green;"><%= flash[:notice] %></p>
<% end %>
<% if flash[:alert] %>
  <p style="color: red;"><%= flash[:alert] %></p>
<% end %>

<%= form_with model: @reservation, local: true do |f| %>
  <%= f.hidden_field :room_id %>

  <!-- バリデーションエラー -->
  <% if @reservation.errors.any? %>
    <div style="color: red;">
      <ul>
        <% @reservation.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :start_at, "チェックイン" %><br>
    <%= f.date_field :start_at, required: true %>
  </div>

  <div>
    <%= f.label :end_at, "チェックアウト" %><br>
    <%= f.date_field :end_at, required: true %>
  </div>

  <div>
    <%= f.label :people, "人数" %><br>
    <%= f.number_field :people, min: 1, value: 1, required: true %>
  </div>

  <div>
    <%= f.submit "予約する", class: "btn btn-primary" %>
  </div>
<% end %>

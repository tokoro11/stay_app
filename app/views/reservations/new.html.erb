<div class="text-center">
  <div class="card room-card">
    <%= image_tag @room.image, class: "card-img-top" if @room.image.attached? %>

    <div class="card-body">
      <div class="room-name">
        <h3><%= @room.title %></h3>
        <p><%= @room.live %></p>
        <p><%= @room.content %></p>
      </div>

      <hr>
      <p>¥<%= @room.money %> / 泊</p>
    </div>
  </div>
</div>

<h1>予約フォーム</h1>

<%= form_with model: @reservation, local: true do |f| %>

  <%= f.hidden_field :room_id %>

  <div>
    <%= f.label :start_at, "開始日" %><br>
    <%= f.date_field :start_at %>
  </div>

  <div>
    <%= f.label :end_at, "終了日" %><br>
    <%= f.date_field :end_at %>
  </div>

  <div>
    <%= f.label :people, "人数" %><br>
    <%= f.number_field :people, min: 1 %>
  </div>

  <div>
    <%= f.submit "予約する", class: "btn btn-primary" %>
  </div>

<% end %>

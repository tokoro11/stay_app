<h1>予約詳細</h1>

<div class="reservation-detail">
  <p>
    <strong>施設名：</strong>
    <%= @reservation.room.title %>
  </p>

  <p>
    <strong>チェックイン：</strong>
    <%= @reservation.start_at.strftime("%Y/%m/%d") %>
  </p>

  <p>
    <strong>チェックアウト：</strong>
    <%= @reservation.end_at.strftime("%Y/%m/%d") %>
  </p>

  <p>
    <strong>人数：</strong>
    <%= @reservation.people %> 人
  </p>

  <p>
    <strong>予約確定日時：</strong>
    <%= @reservation.created_at.strftime("%Y/%m/%d %H:%M") %>
  </p>
</div>

<%= link_to "予約一覧へ戻る", reservations_path %>
